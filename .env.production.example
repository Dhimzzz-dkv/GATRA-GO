###############################################################################
# GATRA-GO — Contoh konfigurasi PRODUKSI
#
# Cara pakai:
#   1. Salin file ini menjadi .env di server produksi
#   2. Ganti SEMUA nilai bertanda <<< GANTI >>>
#   3. Jalankan: php artisan key:generate
#   4. Jalankan: php artisan config:cache && php artisan route:cache && php artisan view:cache
#
# JANGAN commit file .env hasil salinan ke repository.
###############################################################################

APP_NAME="GATRA-GO"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://domain-instansi.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

# ---------------------------------------------------------------------------
# Password akun hasil seeding.
# WAJIB diisi sebelum menjalankan `php artisan db:seed` di produksi.
# Seeder akan berhenti dengan error bila kosong.
# ---------------------------------------------------------------------------
SEED_PASSWORD=<<< GANTI DENGAN PASSWORD KUAT >>>

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging — jangan pakai `debug` di produksi
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simantap
DB_USERNAME=<<< GANTI >>>
DB_PASSWORD=<<< GANTI >>>

# ---------------------------------------------------------------------------
# Session & Cache
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database

# ---------------------------------------------------------------------------
# Queue — gunakan database bila belum ada worker supervisor,
# atau redis bila tersedia.
# ---------------------------------------------------------------------------
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Filesystem — berkas SPT/LHP/bukti setor bersifat internal.
# Disk `local` menulis ke storage/app/private (tidak dapat diakses publik).
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log

# ---------------------------------------------------------------------------
# Email — WAJIB diubah ke SMTP sungguhan.
# `log` hanya menulis email ke berkas log dan TIDAK mengirim apa pun.
# ---------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=<<< GANTI smtp.example.go.id >>>
MAIL_PORT=587
MAIL_USERNAME=<<< GANTI >>>
MAIL_PASSWORD=<<< GANTI >>>
MAIL_FROM_ADDRESS="noreply@domain-instansi.go.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Redis (kosongkan bila tidak digunakan)
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# AWS / S3 (kosongkan bila penyimpanan lokal)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
